# PostgreSQL connection string (required). Powers cross-device sync.
# Create a free database on Neon, Supabase, or Vercel Postgres, then paste it here.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Search needs no API keys — it uses the public Steam Store and
# Wikipedia/Wikidata APIs out of the box.

# OPTIONAL: live PSN Turkey deals come from the public PlayStation Store.
# By default the app parses the public promotions page JSON. If you want
# Sony's GraphQL persisted query instead, copy the sha256Hash from
# DevTools → Network → the categoryGridRetrieve request on
# https://store.playstation.com and set it here:
# PSN_TR_DEALS_HASH=
