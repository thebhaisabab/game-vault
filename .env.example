# PostgreSQL connection string (required). Powers cross-device sync.
# Create a free database on Neon, Supabase, or Vercel Postgres, then paste it here.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Search needs no API keys — it uses the public Steam Store and
# Wikipedia/Wikidata APIs out of the box.

