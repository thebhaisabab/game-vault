# PostgreSQL connection string (optional — powers cross-device sync).
# Create a free database on Neon, Supabase, or Vercel Postgres, then paste it here.
# On Vercel this also enables the PSN deals cache (psn_deals_cache, auto-created):
# live fetches are saved there and served on every device when live is blocked.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Search needs no API keys — it uses the public Steam Store and
# Wikipedia/Wikidata APIs out of the box.

# PSN Turkey deals come from Sony's official Storefront GraphQL API
# (web.np.playstation.com) — no keys. open.er-api.com provides keyless FX.
# PSN_SEARCH_OPERATION=getSearchResults   # optional override
# PSN_SEARCH_SHA256=4df6284f...            # optional override when Sony rotates
